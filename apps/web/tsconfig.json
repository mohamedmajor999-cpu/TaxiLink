{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@taxilink/core": [
        "../../packages/core/src/index.ts"
      ],
      "@taxilink/design-tokens": [
        "../../packages/design-tokens/src/index.ts"
      ],
      "@taxilink/supabase-types": [
        "../../packages/supabase-types/src/index.ts"
      ],
      "@taxilink/services": [
        "../../packages/services/src/index.ts"
      ],
      "@taxilink/stores": [
        "../../packages/stores/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}
