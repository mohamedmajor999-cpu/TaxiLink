# A copier en .env.local et remplir.
# Les vars EXPO_PUBLIC_* sont expose au bundle client (visibles dans l'app).
# Les autres restent serveur-only (EAS, builds).

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API back (les routes /api du site web Next.js)
EXPO_PUBLIC_API_BASE_URL=https://taxilink.fr

# Google Maps key (routing OSRM/Google + autocomplete)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Sentry (memes DSN que web pour partager le projet)
EXPO_PUBLIC_SENTRY_DSN=

# EAS (a remplir apres `eas init`, ne PAS commit)
# EAS_PROJECT_ID=
