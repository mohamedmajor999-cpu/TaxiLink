{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "@taxilink/design-tokens": ["../design-tokens/src/index.ts"]
    }
  },
  "include": ["src", "../../nativewind-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
